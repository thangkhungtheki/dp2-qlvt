<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản Lý Chốt Tuần Tra</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <style>
        .qr-thumb { cursor: pointer; transition: transform 0.2s; border: 1px solid #cbd5e1; border-radius: 4px; }
        .qr-thumb:hover { transform: scale(1.08); border-color: #2563eb; }
    </style>
</head>
<body>
<div class="container-fluid mt-4 mb-5">
    <h2 class="text-primary mb-4">🛡️ QUẢN LÝ CHỐT TUẦN TRA (BẢO VỆ)</h2>
    
    <!-- Cụm Nút chức năng -->
    <div class="d-flex justify-content-between mb-3">
        <button class="btn btn-success font-weight-bold" data-toggle="modal" data-target="#addPointModal">
            + Thêm Chốt Tuần Tra Mới
        </button>
        <div>
            <a href="/api/dp3/baove/nhanvien" class="btn btn-primary mr-2 font-weight-bold">
                👮 Quản Lý Nhân Viên
            </a>
            <a href="/api/dp3/baove/lichsu" class="btn btn-info font-weight-bold">
                📜 Xem Lịch Sử Ca Trực
            </a>
        </div>
    </div>

    <!-- Bảng danh sách chốt -->
    <table class="table table-bordered table-striped">
        <thead class="thead-dark">
            <tr>
                <th style="width: 60px;">STT</th>
                <th>Tên Chốt</th>
                <th>Khu Vực</th>
                <th>Vị Trí</th>
                <th>Checklist Công Việc</th>
                <th style="width: 140px;" class="text-center">QR Code</th>
                <th style="width: 120px;" class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            <% if (!data || data.length === 0) { %>
                <tr>
                    <td colspan="7" class="text-center text-muted font-italic">Chưa có chốt tuần tra nào được tạo.</td>
                </tr>
            <% } %>

            <% data.forEach(function(item, index) { %>
            <tr>
                <td class="align-middle text-center"><%= index + 1 %></td>
                <td class="align-middle font-weight-bold text-dark">
                    <%= item.tencv %>
                    <br>
                    <small class="text-muted">ID: <%= item._id %></small>
                </td>
                <td class="align-middle"><%= item.khuvuc %></td>
                <td class="align-middle"><%= item.vitri %></td>
                <td class="align-middle">
                    <ul class="pl-3 mb-0">
                        <% (item.congviec || []).forEach(function(cv) { %>
                            <li><%= cv %></li>
                        <% }) %>
                    </ul>
                </td>
                <td class="text-center align-middle">
                    <% if(item.maqrcochu) { %>
                        <img src="data:image/png;base64,<%= item.maqrcochu %>" width="95" alt="QR" class="qr-thumb" onclick="showQrModal('data:image/png;base64,<%= item.maqrcochu %>', '<%= item.tencv %>')">
                        <br>
                        <a href="data:image/png;base64,<%= item.maqrcochu %>" download="QR_<%= item.tencv %>.png" class="badge badge-primary mt-2 p-2">⬇️ Tải ảnh in</a>
                    <% } else { %>
                        <span class="text-muted">Chưa có QR</span>
                    <% } %>
                </td>
                <td class="align-middle">
                    <div class="d-flex flex-column align-items-center">
                        <button class="btn btn-sm btn-warning mb-2 w-100 font-weight-bold" data-toggle="modal" data-target="#editPointModal_<%= item._id %>">Sửa</button>
                        
                        <form action="/api/dp3/baove/chottuantra/xoa" method="POST" onsubmit="return confirm('Anh có chắc muốn xóa chốt này?');" class="w-100">
                            <input type="hidden" name="_id" value="<%= item._id %>">
                            <button type="submit" class="btn btn-sm btn-danger w-100 font-weight-bold">Xóa</button>
                        </form>
                    </div>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<!-- Danh sách Modal Sửa Chốt (Đặt ngoài bảng để không làm vỡ cấu trúc HTML table) -->
<% data.forEach(function(item) { %>
<div class="modal fade" id="editPointModal_<%= item._id %>" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/api/dp3/baove/chottuantra/sua" method="POST">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title font-weight-bold">Sửa Chốt Tuần Tra</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="_id" value="<%= item._id %>">
                    
                    <div class="form-group">
                        <label class="font-weight-bold">Tên Chốt:</label>
                        <input type="text" name="tencv" class="form-control" value="<%= item.tencv %>" required>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Khu Vực:</label>
                        <input type="text" name="khuvuc" class="form-control" value="<%= item.khuvuc %>" required>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Vị Trí:</label>
                        <input type="text" name="vitri" class="form-control" value="<%= item.vitri %>" required>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Danh sách Checklist cần kiểm tra:</label>
                        <textarea name="congviec" class="form-control" rows="5" required><%= (item.congviec || []).join('\n') %></textarea>
                        <small class="text-danger">Mỗi công việc bấm <b>ENTER</b> xuống 1 dòng.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning font-weight-bold">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>
<% }) %>

<!-- Modal Thêm Chốt Mới -->
<div class="modal fade" id="addPointModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/api/dp3/baove/chottuantra/them" method="POST">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title font-weight-bold">Tạo Chốt Tuần Tra Mới</h5>
                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="font-weight-bold">Tên Chốt (VD: Chốt Sảnh Lễ Tân):</label>
                        <input type="text" name="tencv" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Khu Vực (VD: Tầng Trệt):</label>
                        <input type="text" name="khuvuc" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Vị Trí (VD: Cửa chính):</label>
                        <input type="text" name="vitri" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Danh sách Checklist cần kiểm tra:</label>
                        <textarea name="congviec" class="form-control" rows="4" placeholder="Kiểm tra hệ thống đèn&#10;Kiểm tra khóa cửa an toàn&#10;Ghi nhận bình cứu hỏa" required></textarea>
                        <small class="text-danger">Mỗi công việc bấm <b>ENTER</b> xuống 1 dòng.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success font-weight-bold">Lưu & Sinh Mã QR</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Phóng to QR để quét thử bằng điện thoại -->
<div class="modal fade" id="qrPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold" id="qrModalTitle">Mã QR Chốt</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
                <img id="qrModalImg" src="" class="img-fluid rounded border">
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function showQrModal(src, title) {
        document.getElementById('qrModalImg').src = src;
        document.getElementById('qrModalTitle').innerText = 'Mã QR: ' + title;
        $('#qrPreviewModal').modal('show');
    }
</script>
</body>
</html>