<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Lịch Sử Tuần Tra An Ninh</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <style>
        .selfie-img { width: 45px; height: 45px; object-fit: cover; border-radius: 50%; border: 2px solid #2563eb; }
        .details-box { background-color: #f8fafc; border-radius: 6px; padding: 15px; margin-top: 10px; display: none; }
        /* Thêm style cho ảnh thu nhỏ ở chốt */
        .patrol-thumb { 
            width: 60px; 
            height: 60px; 
            object-fit: cover; 
            border-radius: 4px; 
            border: 1px solid #cbd5e1; 
            cursor: pointer; 
            transition: transform 0.2s;
        }
        .patrol-thumb:hover { transform: scale(1.1); border-color: #2563eb; }
    </style>
</head>
<body>
<div class="container-fluid mt-4">
    <h2 class="text-primary mb-4">📜 LỊCH SỬ TUẦN TRA AN NINH</h2>
    
    <!-- THANH TÌM KIẾM THEO NGÀY & TÊN -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body bg-light">
            <form action="/api/dp3/baove/lichsu" method="GET" class="form-inline">
                <label class="font-weight-bold mr-2">📅 Chọn Ngày:</label>
                <input type="date" name="date" class="form-control mr-4" value="<%= searchDate %>">
                
                <label class="font-weight-bold mr-2">👤 Tên Bảo Vệ:</label>
                <input type="text" name="guardName" class="form-control mr-4" placeholder="Nhập tên..." value="<%= searchName %>">
                
                <button type="submit" class="btn btn-primary px-4 font-weight-bold">🔍 Tìm Kiếm</button>
                <a href="/api/dp3/baove/lichsu" class="btn btn-secondary ml-2 font-weight-bold">Làm mới</a>
                
                <!-- Menu điều hướng ngang -->
                <a href="/api/dp3/baove/chottuantra" class="btn btn-warning ml-3 font-weight-bold">
                    📍 Quản Lý Chốt
                </a>
                <a href="/api/dp3/baove/nhanvien" class="btn btn-success ml-2 font-weight-bold">
                    👮 Quản Lý Nhân Viên
                </a>
            </form>
        </div>
    </div>

    <!-- BẢNG KẾT QUẢ -->
    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>STT</th>
                <th>Ảnh Nhận Ca</th>
                <th>Người Tuần Tra</th>
                <th>Giờ Bắt Đầu</th>
                <th>Giờ Kết Thúc</th>
                <th>Số Chốt Quét</th>
                <th>Ngày Ghi Nhận</th>
                <th>Chi Tiết</th>
            </tr>
        </thead>
        <tbody>
            <% if(data.length === 0) { %>
                <tr><td colspan="8" class="text-center text-danger font-weight-bold">Không tìm thấy ca trực nào phù hợp.</td></tr>
            <% } %>

            <% data.forEach(function(item, index) { %>
            <tr>
                <td class="align-middle"><%= index + 1 %></td>
                <td class="align-middle text-center">
                    <!-- Ảnh Selfie cũng có thể click để xem to -->
                    <img src="<%= item.selfie %>" class="selfie-img" style="cursor: pointer;" alt="Selfie" onclick="showImageModal('<%= item.selfie %>')">
                </td>
                <td class="align-middle font-weight-bold text-primary"><%= item.guardName %> <br> <small class="text-muted"><%= item.guardCode %></small></td>
                <td class="align-middle text-success font-weight-bold"><%= item.startTime %></td>
                <td class="align-middle text-danger font-weight-bold"><%= item.endTime %></td>
                <td class="align-middle">
                    <span class="badge badge-info" style="font-size:14px;"><%= item.totalPoints %> chốt</span>
                </td>
                <td class="align-middle"><%= moment(item.createdAt).format('DD-MM-YYYY') %></td>
                <td class="align-middle text-center">
                    <button class="btn btn-sm btn-outline-dark" onclick="toggleDetails('details_<%= item._id %>')">Xem Hành Trình</button>
                </td>
            </tr>
            
            <!-- Vùng hiển thị chi tiết -->
            <tr id="details_<%= item._id %>" style="display:none; background-color:#f8fafc;">
                <td colspan="8">
                    <div class="row px-3 pt-2">
                        <% item.checkpoints.forEach(function(point) { %>
                            <div class="col-md-4 mb-3">
                                <div class="card h-100 shadow-sm border-left-primary">
                                    <div class="card-body p-2">
                                        <b class="text-dark">📍 <%= point.checkpointName %></b> <span class="float-right text-muted"><%= point.time %></span>
                                        <p class="mb-1 text-danger small"><%= point.comment ? 'Ghi chú: ' + point.comment : '' %></p>
                                        <hr class="my-1">
                                        
                                        <!-- Danh sách công việc -->
                                        <ul class="pl-3 mb-2" style="font-size:12px;">
                                            <% if(point.congviec) { %>
                                                <% point.congviec.forEach(function(cv) { %>
                                                    <li><%= cv.isDone ? '✅' : '⬛' %> <%= cv.name %></li>
                                                <% }) %>
                                            <% } %>
                                        </ul>

                                        <!-- Render Hình ảnh tuần tra tại chốt -->
                                        <% if(point.anhthuchien && point.anhthuchien.length > 0) { %>
                                            <div class="mt-2 pt-2 border-top">
                                                <% point.anhthuchien.forEach(function(imgBase64) { %>
                                                    <img src="<%= imgBase64 %>" class="patrol-thumb mr-1 mb-1" onclick="showImageModal('<%= imgBase64 %>')" title="Click để phóng to">
                                                <% }) %>
                                            </div>
                                        <% } %>

                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<!-- Modal để hiển thị ảnh phóng to -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" style="font-size: 1.5rem;">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center pt-0 pb-3">
                <img id="enlargedImg" src="" class="img-fluid rounded shadow-sm" style="max-height: 80vh;" alt="Ảnh Tuần Tra Phóng To">
            </div>
        </div>
    </div>
</div>

<!-- Script cần thiết cho Modal Bootstrap hoạt động -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Hàm bật/tắt hiển thị hành trình
    function toggleDetails(rowId) {
        var row = document.getElementById(rowId);
        if (row.style.display === "none") {
            row.style.display = "table-row";
        } else {
            row.style.display = "none";
        }
    }

    // Hàm gắn link ảnh vào Modal và hiển thị Modal
    function showImageModal(imgSrc) {
        document.getElementById('enlargedImg').src = imgSrc;
        $('#imageModal').modal('show');
    }
</script>
</body>
</html>